# Managed by Ansible (roles/nexus). Local edits are overwritten.
server {
    listen 443 ssl;
    server_name {{ registry_hostname }};

    ssl_certificate     /etc/letsencrypt/live/{{ registry_hostname }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ registry_hostname }}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    # Image layers are hundreds of MB: no size limit, and stream them straight
    # through instead of buffering whole uploads on this server's disk first.
    client_max_body_size 0;
    proxy_request_buffering off;
    proxy_buffering off;
    proxy_read_timeout 900s;
    proxy_send_timeout 900s;

    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    # Nexus builds the login URL it hands to Docker from this; without it the
    # client is told to authenticate over http:// and refuses.
    proxy_set_header X-Forwarded-Proto https;

    # Docker registry API -> the repository's own port.
    location /v2/ {
        proxy_pass http://127.0.0.1:{{ nexus_docker_port }};
    }

    # Nexus web UI and REST API.
    location / {
        proxy_pass http://127.0.0.1:8081;
    }
}

server {
    listen 80;
    server_name {{ registry_hostname }};
    return 301 https://$host$request_uri;
}
