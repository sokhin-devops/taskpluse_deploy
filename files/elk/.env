# Values substituted into docker-compose.yml at `docker compose up` time.
# No secrets here - those live in /root/kibana.env on the server, which the
# compose file references via env_file.

# All four components must share one version; mixing them fails with
# unhelpful connection errors.
ELK_VERSION=8.15.0

# Capped explicitly. Defaults are much higher, and on a shared box the OOM
# killer takes the largest process - which would be an API container.
ES_HEAP=1g
LOGSTASH_HEAP=512m
